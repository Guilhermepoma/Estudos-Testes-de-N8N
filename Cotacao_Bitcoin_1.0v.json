        "jsCode": "const data = items[0].json;\n\nconst symbol = Object.keys(data)[0];\nconst price = data[symbol].usd;\n\nconst date = new Date();\nconst dataISO = date.toISOString();\n\nlet status = \"estável\";\nif (price > 70000) status = \"em alta 🚀\";\nif (price < 69000) status = \"em queda 📉\";\n\nreturn [{\n  json: {\n    ativo: symbol,\n    preco: price,\n    status: status,\n    data: dataISO,\n    resumo: `O ${symbol} está ${status}, cotado a $${price.toFixed(2)}.`\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [208, 48],
      "id": "REMOVIDO",
      "name": "Code in JavaScript"
